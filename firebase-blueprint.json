{
  "entities": {
    "arrest_records": {
      "title": "Arrest Records",
      "description": "Criminal arrest reports, fines, and jail logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "suspectName": { "type": "string" },
        "officerName": { "type": "string" },
        "badgeNumber": { "type": "string" },
        "totalFine": { "type": "number" },
        "totalJail": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "suspectName", "officerName", "timestamp"]
    },
    "citizens": {
      "title": "DMV Citizens Database",
      "description": "Citizen records, driver and gun licenses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "citizenId": { "type": "string" },
        "fullName": { "type": "string" },
        "driverLicenseStatus": { "type": "string" },
        "gunLicenseStatus": { "type": "string" },
        "isWantedBolo": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "citizenId", "fullName"]
    },
    "forensics": {
      "title": "Forensics & Ballistics Lab",
      "description": "Crime lab ballistic, GSR, and chemical tests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "labNumber": { "type": "string" },
        "caseReference": { "type": "string" },
        "analysisType": { "type": "string" },
        "findings": { "type": "string" },
        "matchResult": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "labNumber", "analysisType", "findings", "timestamp"]
    },
    "bolos": {
      "title": "BOLO & Impounded Vehicles",
      "description": "Be On the Lookout and vehicle impoundment log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "plate": { "type": "string" },
        "model": { "type": "string" },
        "owner": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "plate", "model", "timestamp"]
    },
    "detective_cases": {
      "title": "CID Detective Cases",
      "description": "Detective investigation dossiers and warrants",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "caseNumber": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "leadDetective": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "caseNumber", "title", "timestamp"]
    },
    "system_configs": {
      "title": "Department System Configurations",
      "description": "Webhook configuration, authority PIN, and settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string" },
        "data": { "type": "object" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "key"]
    }
  },
  "firestore": {
    "collections": {
      "arrest_records": { "entity": "arrest_records" },
      "citizens": { "entity": "citizens" },
      "forensics": { "entity": "forensics" },
      "bolos": { "entity": "bolos" },
      "detective_cases": { "entity": "detective_cases" },
      "evidence_vault": { "entity": "system_configs" },
      "evidence_destruction": { "entity": "system_configs" },
      "official_documents": { "entity": "system_configs" },
      "pin_reset_requests": { "entity": "system_configs" },
      "roster": { "entity": "system_configs" },
      "system_configs": { "entity": "system_configs" }
    }
  }
}
